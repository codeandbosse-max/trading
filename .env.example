# --- Backend (apps/api) ---
PORT=4000

# Laisser vide en développement pour utiliser une base PostgreSQL en mémoire.
# Supabase : Project Settings > Database > Connection string > URI.
# Utiliser le port 6543 (pooler, recommandé) ou 5432 (connexion directe).
#   postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Obligatoire avec Supabase.
DATABASE_SSL=false

CORS_ORIGINS=http://localhost:3000
# Clé hexadécimale de 32 octets (64 caractères) : openssl rand -hex 32
# Chiffre les identifiants courtiers. La changer rend les secrets existants illisibles.
ENCRYPTION_KEY=
WEBHOOK_RATE_LIMIT=60

# Serverless (Vercel) uniquement.
# Protège /api/tasks/tick, appelé par le cron à la place des workers permanents.
CRON_SECRET=
# Mettre 1 derrière un pooler de connexions (Supabase port 6543).
DB_POOL_MAX=10
# Intervalle minimal entre deux traitements déclenchés par une lecture de /api/state.
TICK_MIN_INTERVAL_MS=3000

# --- Routage des ordres ---
# DANGER : à true, les connexions en environnement « réel » envoient de vrais ordres.
ALLOW_LIVE_TRADING=false
# Surcharge l'URL Alpaca (tests). Vide = paper ou live selon l'environnement de la connexion.
ALPACA_BASE_URL=
# Fuseau utilisé par la règle de plage horaire (identifiant IANA).
RISK_TIMEZONE=America/New_York

# --- Alertes externes ---
# Seuil minimal : info, success, warning ou error.
ALERT_MIN_SEVERITY=warning
# POST du JSON brut de la notification.
ALERT_WEBHOOK_URL=
# Webhook entrant Slack ou Discord.
CHAT_WEBHOOK_URL=
# Ex. smtps://utilisateur:motdepasse@smtp.exemple.com:465
SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
