# --- Backend (apps/api) ---
PORT=4000

# Laisser vide en développement pour utiliser une base PostgreSQL en mémoire.
# Supabase : Project Settings > Database > Connection string > URI.
# Utiliser le port 6543 (pooler, recommandé) ou 5432 (connexion directe).
#   postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Obligatoire avec Supabase.
DATABASE_SSL=false

CORS_ORIGINS=http://localhost:3000
# Clé hexadécimale de 32 octets (64 caractères) : openssl rand -hex 32
# Chiffre les identifiants courtiers. La changer rend les secrets existants illisibles.
ENCRYPTION_KEY=
WEBHOOK_RATE_LIMIT=60

# Serverless (Vercel) uniquement.
# Protège /api/tasks/tick, appelé par le cron à la place des workers permanents.
CRON_SECRET=
# Mettre 1 derrière un pooler de connexions (Supabase port 6543).
DB_POOL_MAX=10

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
